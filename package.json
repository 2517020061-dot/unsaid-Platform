{
  "name": "unsaid-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "start": "HOST=0.0.0.0 PORT=3000 node ./dist/server/entry.mjs",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "astro check && tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.4",
    "@astrojs/react": "^5.0.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^6.4.8",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "~4.0.18"
  }
}
